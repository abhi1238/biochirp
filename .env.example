# ===============================
# BioChirp Environment Template
# ===============================
# Copy to .env and fill with real values.
# Do NOT commit secrets.

# ---------- API Keys ----------
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_shared_groq_key_fallback
GEMINI_API_KEY=your_gemini_api_key
GROK_KEY=your_grok_api_key
# Optional compatibility variable used by some components
GROK_API_KEY=your_grok_api_key
TAVILY_API_KEY=your_tavily_api_key

# ---------- Groq Keys (per-DB isolation) ----------
# get_groq_key(db_name) in config/settings.py checks GROQ_API_KEY_<DB> first,
# then falls back to GROQ_API_KEY. Each DB's LLM calls consume its own bucket.
GROQ_API_KEY_TTD=your_ttd_groq_key
GROQ_API_KEY_CTD=your_ctd_groq_key
GROQ_API_KEY_HCDT=your_hcdt_groq_key
GROQ_API_KEY_OPENTARGETS=your_opentargets_groq_key
GROQ_API_KEY_HPO=your_hpo_groq_key
GROQ_API_KEY_CLINVAR=your_clinvar_groq_key
GROQ_API_KEY_REACTOME=your_reactome_groq_key
GROQ_API_KEY_STRING=your_string_groq_key
GROQ_API_KEY_UNIPROT=your_uniprot_groq_key
GROQ_API_KEY_CHEMBL=your_chembl_groq_key
GROQ_API_KEY_ORPHANET=your_orphanet_groq_key
GROQ_API_KEY_MSIGDB=your_msigdb_groq_key
# Pattern: GROQ_API_KEY_<DB_UPPER> — add new DBs here as they are onboarded

# ---------- OpenRouter Keys (per-DB isolation) ----------
# get_openrouter_key(db_name) in config/settings.py checks OPENROUTER_API_KEY_<DB>
# first, then falls back to OPENROUTER_API_KEY. Each DB's LLM calls consume its own bucket.
OPENROUTER_API_KEY=your_shared_openrouter_key_fallback
OPENROUTER_API_KEY_TTD=your_ttd_openrouter_key
OPENROUTER_API_KEY_CTD=your_ctd_openrouter_key
OPENROUTER_API_KEY_HCDT=your_hcdt_openrouter_key
OPENROUTER_API_KEY_OPENTARGETS=your_opentargets_openrouter_key
OPENROUTER_API_KEY_HPO=your_hpo_openrouter_key
OPENROUTER_API_KEY_CLINVAR=your_clinvar_openrouter_key
OPENROUTER_API_KEY_REACTOME=your_reactome_openrouter_key
OPENROUTER_API_KEY_STRING=your_string_openrouter_key
OPENROUTER_API_KEY_UNIPROT=your_uniprot_openrouter_key
OPENROUTER_API_KEY_CHEMBL=your_chembl_openrouter_key
OPENROUTER_API_KEY_ORPHANET=your_orphanet_openrouter_key
OPENROUTER_API_KEY_MSIGDB=your_msigdb_openrouter_key
# Pattern: OPENROUTER_API_KEY_<DB_UPPER> — add new DBs here as they are onboarded

# ---------- Database API Keys (T1.4 expansion) ----------
# DrugBank: academic license required; request at https://go.drugbank.com/
# (full release is gated; see DECISION_POINTS.md AH-1 for status)
DRUGBANK_DOWNLOAD_TOKEN=your_drugbank_token
# ---------- Core Model Selection ----------
INTERPRETER_MODEL_NAME=gpt-4.1-mini
INTERPRETER_AGENT_SCHEMA_MAPPER_MODEL_NAME=gpt-4.1-mini
ORCHESTRATOR_MODEL_NAME=gpt-4.1-mini
SUMMARIZER_MODEL_NAME=gpt-4.1-nano
# Judge runs a filter-style yes/no/short-reason prompt. gpt-4.1-nano is
# 2–3× faster than gpt-4.1-mini on this task with no quality regression.
# Set to `llm-filter-local` to use the on-box gpt-oss:20b alias
# (p50 = 1.05 s — see litellm_config.yaml).
JUDGE_MODEL_NAME=gpt-4.1-nano
# Web-search model: MUST be a Groq gpt-oss model — browser_search is only
# supported on openai/gpt-oss-20b | gpt-oss-120b | gpt-oss-safeguard-20b.
WEB_MODEL_NAME=openai/gpt-oss-120b
LLM_FILTER_MODEL_NAME=gpt-4o-mini

# ---------- Synthesizer Output Mode ----------
# Selects which system prompt schema_kg_chat + per_db_tool's summarizer
# load: resources/prompts/synthesizer.md (story) vs
# resources/prompts/synthesizer_eval.md (eval). Read by BOTH
# app/per_db_tool/schema_kg_chat.py and app/per_db_tool/_finalize.py, so
# the whole fleet flips together on restart.
#   story (default) = warm narrative prose, no bullet/numbered lists —
#     use for real end users.
#   eval = terse Yes/No verdicts + numbered-list enumerations that
#     BioASQ / db-stability-judge benchmarks can score exactly — use
#     ONLY while running an evaluation, then switch back to `story`.
# Prompts are cached per-process (lru_cache / module global), so this
# only takes effect after a container restart.
SYNTHESIZER_MODE=story

# ---------- Runtime & Timeouts ----------
USE_THREAD_WRAPPER=False
AGENT_TIMEOUT_SEC=90
ROUTE_TIMEOUT_SEC=120
MAX_TIMEOUT=120
OPENAI_HTTP_TIMEOUT=45
WEB_TIMEOUT_SEC=90
WEB_TOOL_TIMEOUT=30

# ---------- Matching Controls ----------
FUZZY_SCORE_CUT_SCORE=80
# Legacy variable still present in older paths
FUZZY_SEARCH_CUT_OFF=80
USE_KNEE_CUT_OFF=True
KNEE_CUT_OFF=0.50
LLM_FILTER_MAX_CONCURRENCY=4

# ---------- Graph Planner Controls ----------
# Active in current planner implementation:
MAX_TABLES_IN_COVERAGE=20
STEINER_TIMEOUT_SECONDS=300
# Legacy/no-op in current deterministic Steiner planner path:
USE_GREEDY_ALGORITHM=true
MAX_COMBINATIONS=10000

# ---------- Join Execution Safety ----------
STRICT_JOIN_MODE=true
CROSS_JOIN_THRESHOLD=5000
MAX_RESULT_SIZE=10000000
MAX_UNIQUE_ROWS=1000000

# ---------- Preview / Output ----------
HEAD_VIEW_ROW_COUNT=50
OT_PREVIEW_ROWS=50
OT_MAX_ASSOC_ROWS=0  # 0 = unlimited; set e.g. 200 to cap disease/gene fetches to top-N by score
OT_MAX_TURNS=20
OT_WS_CHUNK_SIZE=32
OT_WS_MIN_DELAY=0.05
OT_WEB_SEARCH_TIMEOUT=30
OT_WEB_MAX_TOKENS=256
LLM_FILTER_URL=https://biochirp.iiitd.edu.in/services/llm_filter/api/llm_member_selection_filter
# OT service models — all required, no hardcoded fallbacks in code
OT_ORCHESTRATOR_MODEL=openai/gpt-oss-120b
OT_NER_MODEL=openai/gpt-oss-120b
OT_REWRITE_MODEL=openai/gpt-oss-120b
OT_REASONING_EFFORT=
OT_CONN_CACHE_MAX=

# ---------- Optional DB-related vars ----------
# No Postgres service is used by docker-compose.yml today (per-DB tools read
# parquet directly) — these are only consulted by scripts/security/rotate_postgres_password.sh
# if you run an auxiliary local Postgres instance yourself.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Optional explicit DB labels/paths used in some scripts
TTD_DB_NAME=ttd
CTD_DB_NAME=ctd
HCDT_DB_NAME=hcdt

TTD_DB_PATH=database/ttd
CTD_DB_PATH=database/ctd
HCDT_DB_PATH=database/hcdt

# ---------- Public-Tier / License Compliance ----------
# Set to 1 on public deployments. Activates upstream-license filters so
# rows that cannot be redistributed under the deployment's terms are
# dropped at load time. Currently enforced by:
#   - omnipath (academic-source filter; see app/tools/omnipath/app/database_loader.py)
# CC BY-SA databases (chembl, drugcentral, pharmgkb, trrust) and
# non-commercial / custom-licensed databases (ctd, hpo, ttd) rely on the
# attribution footer + TERMS_OF_SERVICE.md for compliance — no row-level
# filter is applied to them.
BIOCHIRP_PUBLIC_TIER=0

# ---------- Unified LLM Filter (per memory: UNIFIED_LLM_FILTER 2026-05-15) ----------
# When 1, services return raw candidates via `raw=true` and the
# expand_and_match_db tool runs a single LLM call per term across all DBs.
UNIFIED_LLM_FILTER=1
# Bypass the orchestrator hop and call the unified filter directly.
UNIFIED_LLM_DIRECT=0
# Use the local Ollama-backed filter (qwen2.5-coder:7b, falls back to phi4:14b).
UNIFIED_LLM_OLLAMA_DIRECT=0
# Top-K candidates kept after the hybrid (BM25 + fastembed) prescreen.
UNIFIED_LLM_PRESCREEN_TOPK=200

# ---------- Semantic Filter Pipeline ----------
# Choose the embedding backend used by the semantic_filter service.
# Empty or "fastembed" = local fastembed; "openai" = OpenAI embeddings.
SEMANTIC_PIPELINE_ENCODE=fastembed

# ---------- Router Model (chat-page entry point) ----------
# MUST be a fast cloud model; per memory, a CPU-only Ollama router stalls
# every chat page on "Connecting…".
ROUTER_MODEL_NAME=gpt-4.1-mini

# ---------- Row-level relevance scoring (BGE embed + cosine sort) ----------
# After join_and_filter_database produces the final DataFrame, each row is
# embedded as a short text string using BGE-small (fastembed ONNX, CPU-only)
# and sorted descending by cosine similarity to the user query.
# Set to 0 to disable entirely (e.g. CPU-constrained containers or very wide tables).
BIOCHIRP_RELEVANCE_SORT=1
# ── Embedding models — all resolved via config.settings (the model SSOT).
# fastembed ONNX model; must match what Dockerfile.base pre-downloads.
ROW_RELEVANCE_MODEL=BAAI/bge-small-en-v1.5
# schema_kg ANN retrieval (sentence-transformers).
SCHEMA_KG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# schema_kg ANN search hyperparameters (config.py reads these at import time).
# TOP_K: column candidates fetched before the LLM filter (default 25).
# THRESHOLD: minimum cosine similarity to include a column (default 0.30).
SCHEMA_KG_ANN_TOP_K=25
SCHEMA_KG_ANN_THRESHOLD=0.30
# Qdrant service hostname on the Docker bridge network.
QDRANT_HOST=bioc_qdrant
QDRANT_PORT=6333
# SapBERT value embeddings (Qdrant ingest + opentarget resolver).
SAPBERT_MODEL=cambridgeltl/SapBERT-from-PubMedBERT-fulltext-mean-token
# Per-column schema-description embeddings (planner + precompute).
COLUMN_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Multi-encoder set for the semantic value filter + Qdrant value ingest
# (config.settings.BIOMEDICAL_MODELS). Comma-separated; each must be registered
# in config.settings.EMBEDDING_MODELS.
BIOMEDICAL_EMBEDDING_MODELS=cambridgeltl/SapBERT-from-PubMedBERT-fulltext-mean-token
# OpenTargets service LLM models (resolved via config.settings).
NER_MODEL_NAME=gpt-4.1-mini
TRACE_EXPLAINER_MODEL_NAME=gpt-4.1-mini
# Batch size passed to fastembed (internally capped to 128 by bge-small).
ROW_RELEVANCE_BATCH=512
# Max row fields serialised into the embed text per row.
ROW_RELEVANCE_MAX_FIELDS=10
# Skip scoring for result tables smaller than this (sort order doesn't matter for tiny sets).
ROW_RELEVANCE_MIN_ROWS=2
# Skip scoring for result tables larger than this (prevent unbounded encode time).
# 500 is the recommended ceiling: below it the BGE embed is fast (<1s on CPU) and
# ranking quality clearly improves; above it latency dominates the benefit.
# OpenTargets never uses this pipeline (remote GraphQL service), so no exclusion needed.
ROW_RELEVANCE_MAX_ROWS=1000
